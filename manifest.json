{
  "name": "SHARELINKGAN — PGNet",
  "short_name": "SHARELINKGAN",
  "description": "Pantau barang buruan, catat pembelian, dan lihat komisi.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "portrait",
  "background_color": "#f3f5f4",
  "theme_color": "#1f6f54",
  "lang": "id",
  "icons": [
    {
      "src": "ikon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "ikon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "ikon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./bagikan",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "image/*",
            "application/pdf",
            ".pdf"
          ]
        }
      ]
    }
  }
}